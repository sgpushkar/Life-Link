# LifeLink Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifelink?schema=public

# Backend API
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=lifelink_jwt_access_secret_development_key_32bytes_long_min!
JWT_REFRESH_SECRET=lifelink_jwt_refresh_secret_development_key_32bytes_long_min!
CORS_ORIGIN=http://localhost:3000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Third-Party Messaging Adapters
# Options: mock | twilio | msg91
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
ABDM_PROVIDER=mock

# Twilio Stubs (optional when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 Stubs (optional when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=mock_msg91_auth_key
MSG91_SENDER_ID=LIFELK

# Demo Mode Settings
DEMO_OTP_CODE=123456
DEFAULT_ROAD_SPEED_KMPH=40
