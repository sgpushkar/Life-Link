{
  "name": "lifelink-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LifeLink — Real-Time Healthcare Inventory Sharing Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @lifelink/* dev",
    "dev:api": "pnpm --filter @lifelink/api dev",
    "dev:web": "pnpm --filter @lifelink/web dev",
    "build": "pnpm --filter @lifelink/shared build && pnpm --filter @lifelink/api build && pnpm --filter @lifelink/web build",
    "test": "pnpm --filter @lifelink/api test",
    "db:generate": "pnpm --filter @lifelink/api db:generate",
    "db:push": "pnpm --filter @lifelink/api db:push",
    "db:migrate": "pnpm --filter @lifelink/api db:migrate",
    "db:seed": "pnpm --filter @lifelink/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
